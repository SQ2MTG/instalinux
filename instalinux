######## podniesienie do sudo
check_sudo() {
    if [[ $EUID -eq 0 ]]; then
        return 0
    fi

    echo "Podnoszę uprawnienia..."

    if command -v sudo >/dev/null 2>&1; then
        exec sudo "$0" "$@"
    else
        exec su -c "\"$(readlink -f "$0")\" $*"
    fi
}

######## dodanie usera do grupy sudo (debian)
addsudo() {

    # Sprawdzenie systemu
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release
    else
        echo "Nie mozna wykryc systemu."
        return 1
    fi

    case "$ID" in
        ubuntu)
            echo "Wykryto Ubuntu — pomijam konfiguracje sudo."
            return 0
            ;;
        debian)
            echo "Wykryto Debian."
            ;;
        *)
            echo "To nie jest Debian ani Ubuntu — pomijam."
            return 0
            ;;
    esac

    # Zapytaj o nazwę użytkownika
    read -p "Podaj nazwe uzytkownika do dodania do grupy sudo: " USER_TO_ADD

    # Sprawdzenie czy użytkownik istnieje
    if ! id "$USER_TO_ADD" >/dev/null 2>&1; then
        echo "Uzytkownik $USER_TO_ADD nie istnieje."
        return 1
    fi

    # Sprawdzenie czy jest już w grupie sudo
    if id -nG "$USER_TO_ADD" | grep -qw sudo; then
        echo "Uzytkownik $USER_TO_ADD jest juz w grupie sudo."
        return 0
    fi

    echo "Dodaje uzytkownika $USER_TO_ADD do grupy sudo..."
    usermod -aG sudo "$USER_TO_ADD"

    if [[ $? -eq 0 ]]; then
        echo "Uzytkownik $USER_TO_ADD zostal dodany do grupy sudo."
    else
        echo "Wystapil blad podczas dodawania."
        return 1
    fi
}

######## Sprawdzanie wolnego miejsca na dysku
check_disk_space() {
    echo -e "\033[0mINSTALINUX: \033[41;1mSprawdzam dostepne miejsce na dysku...\033[0m"
    local disk_usage=$(df -h / | awk 'NR==2 {print $5}' | sed 's/%//')
    if [ $disk_usage -gt 85 ]; then
        echo -e "\033[0mINSTALINUX: \033[41;1mWolne miejsce na dysku jest niewystarczajace! <15%.\033[0m"
        while true; do
            read -p "Czy chcesz kontynuowac? (y/n): " choice
            case "$choice" in
                y|Y ) echo "Kontynuuje..."; break;;
                n|N ) echo "Przerywam skrypt."; exit 1;;
                * ) echo "Uzyj 'y' lub 'n'.";;
            esac
        done
    else
        echo "Wolne miejsce na dysku jest wystarczajace zeby kontynuowac..."
        sleep 3
    fi
}

######## instalacja pakietow
pkg_install() {
    local WYBOR
    declare -a PAKIETY=()

    # CHECKLISTA
    WYBOR=$(whiptail --title "Instalacja pakietów" \
        --checklist "Wybierz pakiety do zainstalowania:" 25 80 15 \
        "git"             "System kontroli wersji"                OFF \
        "ssh"             "Klient OpenSSH"                        OFF \
        "curl"            "Transfer danych URL"                   OFF \
        "wget"            "Pobieranie plików"                      OFF \
        "gzip"            "Kompresja plików"                       OFF \
        "make"            "Narzędzie budowania"                    OFF \
        "cmake"           "System budowania projektów"             OFF \
        "build-essential" "Podstawowe narzędzia kompilacyjne"      OFF \
        "gdebi"           "Instalacja pakietów .deb"               OFF \
        "htop"            "Monitor procesów"                       OFF \
        "rdate"           "Synchronizacja czasu"                   OFF \
        "nodejs"      "Node.js + npm"                          OFF \
        "php"             "Interpreter PHP"                        OFF \
        "audio"           "Pakiety audio (alsa, libasound2)"       OFF \
        "POMIN"           ">>> Pomiń instalację i przejdź dalej <<<" OFF \
        3>&1 1>&2 2>&3)

    local STATUS=$?
    [ $STATUS -ne 0 ] && return 2

    WYBOR=$(echo "$WYBOR" | tr -d '"')

    # Pomiń instalację
    if echo "$WYBOR" | grep -qw POMIN; then
        return 1
    fi

    # Zamiana wybranych pakietów na listę
    for pkg in $WYBOR; do
        case $pkg in
            nodejs)
                PAKIETY+=("nodejs" "npm")
                ;;
            audio)
                PAKIETY+=("alsa-utils" "libasound2-dev")
                ;;
            *)
                PAKIETY+=("$pkg")
                ;;
        esac
    done

    if [ ${#PAKIETY[@]} -eq 0 ]; then
        whiptail --msgbox "Nie wybrano żadnych pakietów." 10 50
        return 2
    fi

    # POTWIERDZENIE
    whiptail --yesno "Zainstalować pakiety:\n\n${PAKIETY[*]} ?" 15 70
    [ $? -ne 0 ] && return 2

    # GAUGE – pasek postępu instalacji
    local COUNT=0
    local TOTAL=${#PAKIETY[@]}

    {
        for pkg in "${PAKIETY[@]}"; do
            COUNT=$((COUNT+1))
            PERCENT=$(( COUNT * 100 / TOTAL ))
            printf "XXX\n%d\n%s\nXXX\n" "$PERCENT" "Instalowanie: $pkg..."
            sudo apt install -y "$pkg" > /dev/null 2>&1
        done
    } | whiptail --gauge "Instalacja pakietów..." 10 70 0

    whiptail --msgbox "Instalacja zakończona!" 10 50
    return 0
}

######## instalacja oprogramowania opcjonalnego
