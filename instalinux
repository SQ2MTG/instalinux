        --checklist "Wybierz opcje do wykonania:" 25 80 15 \
        "rc_local"       "Przywrócenie rc.local"               OFF \
        "sdr_rtl"        "SDR RTL + BLACKLIST"                 OFF \
        "sdr_rsp1"       "SDR RSP1"                            OFF \
        "vpn_wireguard"  "VPN Wireguard"                        OFF \
        "vpn_zerotier"   "VPN ZeroTier"                         OFF \
        "cockpit"        "Cockpit + plugins"                   OFF \
        "docker"         "Docker + Compose + Portainer"        OFF \
        "lynis"          "Lynis audit"                          OFF \
        "POMIN"          ">>> Pomiń i przejdź dalej <<<"       OFF \
        3>&1 1>&2 2>&3)

    local STATUS=$?
    [ $STATUS -ne 0 ] && return 1

    WYBOR=$(echo "$WYBOR" | tr -d '"')

    # Opcja pomiń
    if echo "$WYBOR" | grep -qw POMIN; then
        return 2
    fi

    # Zamiana wybranych opcji na tablicę
    for opcja in $WYBOR; do
        OPCJE_WYBRANE+=("$opcja")
    done

    if [ ${#OPCJE_WYBRANE[@]} -eq 0 ]; then
        whiptail --msgbox "Nie wybrano żadnych opcji." 10 50
        return 2
    fi

    # GAUGE – pasek postępu
    local COUNT=0
    local TOTAL=${#OPCJE_WYBRANE[@]}

    {
        for opcja in "${OPCJE_WYBRANE[@]}"; do
            COUNT=$((COUNT+1))
            PERCENT=$(( COUNT * 100 / TOTAL ))
            printf "XXX\n%d\n%s\nXXX\n" "$PERCENT" "Instalowanie: $opcja..."

            case $opcja in
                rc_local)
                    cd ~ && bash <(curl -s https://www.adminsehow.com/wp-content/uploads/2019/10/rc-local.txt) > /dev/null 2>&1
                    ;;
                sdr_rtl)
                    cd ~ && git clone https://github.com/osmocom/rtl-sdr > /dev/null 2>&1 && cd rtl-sdr/ && mkdir build && cd build && cmake ../ -DINSTALL_UDEV_RULES=ON -DDETACH_KERNEL_DRIVER=ON > /dev/null 2>&1 && make > /dev/null 2>&1 && sudo make install > /dev/null 2>&1 && sudo cp ../rtl-sdr.rules /etc/udev/rules.d/ && sudo ldconfig && echo "blacklist dvb_core
blacklist dvb_usb_rtl28xxu
blacklist dvb_usb_rtl2832u
blacklist dvb_usb_v2
blacklist e4000
blacklist fc0013
blacklist r820t
blacklist rtl2830
blacklist rtl2832
blacklist sdr_msi3101
blacklist msi001
blacklist msi2500" > no-rtl.conf && sudo mv no-rtl.conf /etc/modprobe.d/ > /dev/null 2>&1
                    ;;
                sdr_rsp1)
                    cd ~ && git clone https://github.com/f4exb/libmirisdr-4.git > /dev/null 2>&1 && cd libmirisdr-4 && mkdir build && cd build && cmake -Wno-dev -DCMAKE_INSTALL_PREFIX=/opt/install/libmirisdr .. > /dev/null 2>&1 && make -j $(nproc) install > /dev/null 2>&1
                    ;;
                vpn_wireguard)
                    cd ~ && apt install wireguard wireguard-tools -y > /dev/null 2>&1
                    ;;
                vpn_zerotier)
                    curl -s https://install.zerotier.com | sudo bash > /dev/null 2>&1
                    ;;
                cockpit)
                    apt install cockpit* -y > /dev/null 2>&1 && sudo systemctl start cockpit > /dev/null 2>&1
                    ;;
                docker)
                    cd ~ && curl -fsSL https://get.docker.com -o get-docker.sh > /dev/null 2>&1 && sudo sh get-docker.sh > /dev/null 2>&1 && apt install docker-compose -y > /dev/null 2>&1 && docker run -d \
  -p 9001:9001 \
  --name portainer_agent \
  --restart=always \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /var/lib/docker/volumes:/var/lib/docker/volumes \
  portainer/agent:latest > /dev/null 2>&1
                    ;;
                lynis)
                    sudo curl -fsSL https://packages.cisofy.com/keys/cisofy-software-public.key | sudo gpg --dearmor -o /etc/apt/trusted.gpg.d/cisofy-software-public.gpg > /dev/null 2>&1 && echo "deb [arch=amd64,arm64 signed-by=/etc/apt/trusted.gpg.d/cisofy-software-public.gpg] https://packages.cisofy.com/community/lynis/deb/ stable main" | sudo tee /etc/apt/sources.list.d/cisofy-lynis.list > /dev/null 2>&1 && sudo apt install apt-transport-https -y > /dev/null 2>&1 && apt update > /dev/null 2>&1 && apt install lynis -y > /dev/null 2>&1
                    ;;
            esac

            sleep 1  # opcjonalne, żeby pasek się wizualnie przesuwał
        done
    } | whiptail --gauge "Wykonywanie wybranych opcji..." 10 70 0

    whiptail --msgbox "Wykonanie zakończone!" 10 50
    return 0
}

